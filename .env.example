HTTP_ADDR=:8080
WS_PATH=/ws

# MySQL（持久化基准源：消息/水位线/回执明细）
MYSQL_DSN=root:rootpass@tcp(mysql:3306)/im?parseTime=true&charset=utf8mb4&loc=Local

# Redis（热点/计数/回执集合/水位线/路由）
REDIS_ADDR=redis:6379
REDIS_PASS=
REDIS_DB=0

# 节点与降级参数
NODE_ID=node-1
BIG_GROUP_THRESHOLD=200   # 超过此成员数视为超大群，回执降级
OFFLINE_RING_CAP=30        # 离线消息环保留最近 N 条
RECEIPT_DEGRADE=0          # 置 1 全局关闭单条回执（仅保留水位线），优先保主链路
