    READ --> L1
    L1 --> L2
    B2 --> FIX
    FIX --> L3
    L3 --> G1
    G1 -->|"不通过"| OUT2
    G1 -->|"通过 GO"| R1
    R1 --> R2 --> R3 --> R4 --> A0

    subgraph L1["第 1 步 · 造题"]
        direction LR
        A1 --> A2
    end

    subgraph L2["第 2 步 · 出答案（不用人标）"]
